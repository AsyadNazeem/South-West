# Backend runtime
NODE_ENV=development
PORT=5001

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_database_password

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# Customer authentication
CUSTOMER_JWT_SECRET=replace_with_a_different_long_random_secret
CUSTOMER_JWT_EXPIRES_IN=1d
CUSTOMER_VERIFICATION_SECRET=replace_with_a_long_random_secret

# Frontend URLs
CUSTOMER_APP_URL=http://localhost:5174
CUSTOMER_FRONTEND_URL=http://localhost:5174
ADMIN_FRONTEND_URL=http://localhost:5173

# File and social sharing URLs
# Absolute directory used for uploaded media
UPLOAD_ROOT=

FILE_BASE_URL=http://localhost:5001
PUBLIC_SITE_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:5001

# Email provider: mailpit (local), brevo (production), or smtp (generic)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=South West <noreply@southwest.local>

# Local Mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# Brevo SMTP credentials (production)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Legacy generic SMTP compatibility
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/customer-auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace_with_a_long_random_secret
