
'use strict';

const crypto = require('crypto');
const { Op } = require('sequelize');

const db = require('../models');

const {
    sequelize,
    Cart,
    CartItem,
    Item,
    ItemPrice,
    CustomerAddress,
    DeliveryArea,
    DeliveryDistrict,
    InventoryLocation,
    InventoryStock,
    InventoryStockMovement,
    Order,
    OrderItem,
    OrderAddress,
    Delivery,
    Payment,
    Invoice
} = db;

const CURRENCY = 'LKR';
const PRICE_TYPE = 'selling';


const IDEMPOTENCY_KEY_MAX_LENGTH = 100;

function getIdempotencyKey(req) {
    const key = req.get('Idempotency-Key');

    if (
        typeof key !== 'string' ||
        key.length === 0 ||
        key.length > IDEMPOTENCY_KEY_MAX_LENGTH ||
        !/^[A-Za-z0-9._:-]+$/.test(key)
    ) {
        return null;
    }

    return key;
}

function hashCheckoutRequest(addressId, paymentMethod) {
    return crypto
        .createHash('sha256')
        .update(JSON.stringify({
            address_id: Number(addressId),
            payment_method: paymentMethod
        }))
        .digest('hex');
}


function generateReference(prefix) {
    return `${prefix}-${Date.now()}-${crypto.randomBytes(5).toString('hex')}`;
}

function money(value) {
    return Math.round((Number(value) + Number.EPSILON) * 100) / 100;
}

function positiveId(value) {
    return (
        (typeof value === 'number' || (typeof value === 'string' && /^\d+$/.test(value))) &&
        Number.isSafeInteger(Number(value)) &&
        Number(value) > 0
    );
}

async function getSellingPrice(itemId, transaction) {
    const now = new Date();

    return ItemPrice.findOne({
        where: {
            item_id: itemId,
            price_type: PRICE_TYPE,
            currency: CURRENCY,
            is_active: true,
            [Op.and]: [
                {
                    [Op.or]: [
                        { effective_from: null },
                        { effective_from: { [Op.lte]: now } }
                    ]
                },
                {
                    [Op.or]: [
                        { effective_to: null },
                        { effective_to: { [Op.gte]: now } }
                    ]
                }
            ]
        },
        order: [
            ['effective_from', 'DESC'],
            ['id', 'DESC']
        ],
        transaction
    });
}

async function checkout(req, res) {
    const customerId = req.customer?.id;
    const { address_id, payment_method } = req.body || {};

    if (!customerId) {
        return res.status(401).json({
            message: 'Customer authentication required.'
        });
    }

    if (!positiveId(address_id)) {
        return res.status(400).json({
            message: 'A valid saved delivery address ID is required.'
        });
    }

    if (!['cash', 'online'].includes(payment_method)) {
        return res.status(400).json({
            message: 'Payment method must be cash or online.'
        });
    }

    let transaction;

    try {
        transaction = await sequelize.transaction();

        // Lock the customer's active cart.
        const cart = await Cart.findOne({
            where: {
                customer_id: customerId,
                status: 'active'
            },
            order: [['id', 'DESC']],
            transaction,
            lock: transaction.LOCK.UPDATE
        });

        if (!cart) {
            await transaction.rollback();
            return res.status(400).json({
                message: 'Your cart is empty.'
            });
        }

        const cartItems = await CartItem.findAll({
            where: { cart_id: cart.id },
            order: [['item_id', 'ASC']],
            transaction,
            lock: transaction.LOCK.UPDATE
        });

        if (!cartItems.length) {
            await transaction.rollback();
            return res.status(400).json({
                message: 'Your cart is empty.'
            });
        }

        // Only use an address belonging to this authenticated customer.
        const address = await CustomerAddress.findOne({
            where: {
                id: address_id,
                customer_id: customerId,
                address_type: 'shipping'
            },
            transaction
        });

        if (!address) {
            await transaction.rollback();
            return res.status(400).json({
                message: 'The selected delivery address is invalid.'
            });
        }

        // Validate the selected delivery area and its district.
        const area = await DeliveryArea.findOne({
            where: {
                id: address.area_id,
                district_id: address.district_id,
                status: 1
            },
            transaction
        });

        const district = await DeliveryDistrict.findOne({
            where: {
                id: address.district_id,
                status: 1
            },
            transaction
        });

        if (!area || !district) {
            await transaction.rollback();
            return res.status(400).json({
                message: 'Delivery is not available for this address.'
            });
        }

        // Load each item and calculate its price and shipping weight on the server.
        const preparedItems = [];
        let subtotal = 0;
        let totalWeightKg = 0;

        for (const cartItem of cartItems) {
            const item = await Item.findByPk(cartItem.item_id, {
                transaction
            });

            if (!item || !item.is_active) {
                throw Object.assign(
                    new Error('A product in your cart is no longer available.'),
                    { statusCode: 409 }
                );
            }

            const quantity = Number(cartItem.quantity);

            if (!Number.isSafeInteger(quantity) || quantity <= 0) {
                throw Object.assign(
                    new Error('A cart item has an invalid quantity.'),
                    { statusCode: 400 }
                );
            }

            const priceRecord = await getSellingPrice(item.id, transaction);

            if (!priceRecord || Number(priceRecord.price) < 0) {
                throw Object.assign(
                    new Error(`No valid selling price is available for ${item.item_name}.`),
                    { statusCode: 409 }
                );
            }

            if (item.shipping_weight == null ||
                !Number.isFinite(Number(item.shipping_weight)) ||
                Number(item.shipping_weight) <= 0) {
                throw Object.assign(
                    new Error(`A valid shipping weight must be configured for ${item.item_name}.`),
                    { statusCode: 409 }
                );
            }

            const weightKg = item.shipping_weight_unit === 'g'
                ? Number(item.shipping_weight) / 1000
                : Number(item.shipping_weight);

            const unitPrice = money(priceRecord.price);
            const lineTotal = money(unitPrice * quantity);

            subtotal = money(subtotal + lineTotal);
            totalWeightKg += weightKg * quantity;

            preparedItems.push({
                item,
                quantity,
                unitPrice,
                lineTotal
            });
        }

        // Shipping rule: first kg charge plus each additional kg charge.
        const billableKg = Math.max(1, Math.ceil(totalWeightKg));

        const shippingAmount = money(
            Number(area.first_kg_charge) +
            (billableKg - 1) * Number(area.additional_kg_charge)
        );

        // Promotions and taxes are intentionally not applied until their
        // approved business rules are implemented.
        const discountAmount = 0;
        const taxAmount = 0;
        const totalAmount = money(
            subtotal - discountAmount + taxAmount + shippingAmount
        );

        // Find active online inventory locations.
        const onlineLocations = await InventoryLocation.findAll({
            where: {
                location_type: 'online',
                is_active: true
            },
            order: [['id', 'ASC']],
            transaction
        });

        if (!onlineLocations.length) {
            throw Object.assign(
                new Error('Online inventory is not configured.'),
                { statusCode: 503 }
            );
        }

        const locationIds = onlineLocations.map(location => location.id);

        // Lock inventory rows in a consistent order to reduce race conditions.
        const stockRows = await InventoryStock.findAll({
            where: {
                item_id: preparedItems.map(entry => entry.item.id),
                location_id: locationIds,
                is_active: true
            },
            order: [
                ['item_id', 'ASC'],
                ['location_id', 'ASC']
            ],
            transaction,
            lock: transaction.LOCK.UPDATE
        });

        const stocksByItem = new Map();

        for (const stock of stockRows) {
            const key = String(stock.item_id);

            if (!stocksByItem.has(key)) {
                stocksByItem.set(key, []);
            }

            stocksByItem.get(key).push(stock);
        }

        // Recheck availability inside the transaction.
        for (const entry of preparedItems) {
            const stocks = stocksByItem.get(String(entry.item.id)) || [];

            const available = stocks.reduce((sum, stock) => {
                return sum + Math.max(
                    0,
                    Number(stock.quantity_on_hand) -
                    Number(stock.quantity_reserved)
                );
            }, 0);

            if (available < entry.quantity) {
                throw Object.assign(
                    new Error(
                        `Insufficient online stock for ${entry.item.item_name}. Available: ${available}.`
                    ),
                    { statusCode: 409 }
                );
            }

            if (!stocks.length) {
                throw Object.assign(
                    new Error(`No active online stock record exists for ${entry.item.item_name}.`),
                    { statusCode: 409 }
                );
            }
        }

        const orderNumber = generateReference('SWO');
        const invoiceNumber = generateReference('SWI');
        const deliveryReference = generateReference('SWD');
        const paymentReference = generateReference('SWP');

        const order = await Order.create({
            order_number: orderNumber,
            invoice_number: invoiceNumber,
            customer_id: customerId,
            order_date: new Date(),
            order_type: 'online',
            status: 'pending',
            payment_status: 'unpaid',
            fulfillment_status: 'unfulfilled',
            subtotal,
            discount_amount: discountAmount,
            tax_amount: taxAmount,
            shipping_amount: shippingAmount,
            total_amount: totalAmount,
            notes: null,
            created_by: null
        }, { transaction });

        for (const entry of preparedItems) {
            await OrderItem.create({
                order_id: order.id,
                item_id: entry.item.id,
                quantity: entry.quantity,
                unit_price: entry.unitPrice,
                discount_amount: 0,
                discount_percentage_mode: false,
                discount_percentage: 0,
                tax_amount: 0,
                line_total: entry.lineTotal
            }, { transaction });
        }

        // Store a snapshot so future address edits do not change this order.
        await OrderAddress.create({
            order_id: order.id,
            address_type: 'shipping',
            recipient_name: address.recipient_name,
            phone: address.phone,
            address_line_1: address.address_line_1,
            address_line_2: address.address_line_2,
            city: address.city,
            state: address.state,
            postal_code: address.postal_code,
            country: address.country
        }, { transaction });

        await Delivery.create({
            delivery_reference: deliveryReference,
            order_id: order.id,
            delivery_method: 'standard',
            delivery_status: 'pending',
            recipient_name: address.recipient_name,
            recipient_phone: address.phone,
            address_line_1: address.address_line_1,
            address_line_2: address.address_line_2,
            city: address.city,
            state: address.state,
            postal_code: address.postal_code,
            country: address.country,
            delivery_charge: shippingAmount
        }, { transaction });

        // Never mark an online payment paid before verified provider confirmation.
        await Payment.create({
            payment_reference: paymentReference,
            order_id: order.id,
            payment_method,
            payment_status: 'unpaid',
            amount: totalAmount,
            transaction_reference: null,
            payment_date: null,
            notes: payment_method === 'online'
                ? 'Awaiting payment provider integration and verified confirmation.'
                : 'Cash on delivery. Payment is outstanding.',
            processed_by: null
        }, { transaction });

        await Invoice.create({
            invoice_number: invoiceNumber,
            order_id: order.id,
            customer_id: customerId,
            invoice_date: new Date(),
            status: 'issued',
            subtotal,
            discount_amount: discountAmount,
            tax_amount: taxAmount,
            shipping_amount: shippingAmount,
            total_amount: totalAmount,
            paid_amount: 0,
            balance_amount: totalAmount,
            created_by: null
        }, { transaction });

        // Deduct stock and record each movement in the same transaction.
        for (const entry of preparedItems) {
            let remaining = entry.quantity;
            const stocks = stocksByItem.get(String(entry.item.id)) || [];

            for (const stock of stocks) {
                if (remaining <= 0) break;

                const available = Math.max(
                    0,
                    Number(stock.quantity_on_hand) -
                    Number(stock.quantity_reserved)
                );

                const deduction = Math.min(available, remaining);

                if (deduction <= 0) continue;

                await stock.update({
                    quantity_on_hand: Number(stock.quantity_on_hand) - deduction
                }, { transaction });

                await InventoryStockMovement.create({
                    item_id: entry.item.id,
                    location_id: stock.location_id,
                    movement_type: 'sale',
                    quantity: deduction,
                    reference_type: 'order',
                    reference_id: order.id,
                    notes: `Online checkout ${orderNumber}`,
                    created_by: null,
                    created_at: new Date()
                }, { transaction });

                remaining -= deduction;
            }

            if (remaining > 0) {
                throw Object.assign(
                    new Error(`Stock changed while processing ${entry.item.item_name}. Please try again.`),
                    { statusCode: 409 }
                );
            }
        }

        // Convert the cart only after every order operation succeeds.
        await cart.update({ status: 'converted' }, { transaction });

        await transaction.commit();

        return res.status(201).json({
            message: 'Order created successfully.',
            order: {
                id: order.id,
                order_number: orderNumber,
                status: 'pending',
                payment_status: 'unpaid',
                subtotal,
                shipping_amount: shippingAmount,
                total_amount: totalAmount,
                currency: CURRENCY
            },
            payment: {
                method: payment_method,
                status: 'unpaid',
                reference: paymentReference
            }
        });
    } catch (error) {
        if (transaction && !transaction.finished) {
            await transaction.rollback();
        }

        if (error.statusCode) {
            return res.status(error.statusCode).json({
                message: error.message
            });
        }

        console.error('Customer checkout failed:', error.message);

        return res.status(500).json({
            message: 'Checkout could not be completed. No order changes were saved.'
        });
    }
}

module.exports = { checkout };
